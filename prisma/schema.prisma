generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String
  group     String
  password  String?
  role      Role      @default(USER)
  status    Status    @default(PENDING)
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Room {
  id          String    @id @default(cuid())
  name        String
  capacity    Int
  description String?
  bookings    Booking[]
}

model Booking {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  startTime DateTime
  endTime   DateTime
  notes     String?
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

enum Role {
  USER
  ADMIN
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}
