generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String
  group     String
  password          String?
  mustChangePassword Boolean  @default(false)
  role              Role     @default(USER)
  status            Status   @default(PENDING)
  bookingAccess     Boolean  @default(true)
  kamperAccess      Boolean  @default(false)
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Room {
  id          String    @id @default(cuid())
  name        String
  capacity    Int
  description String?
  bookings    Booking[]
}

model Booking {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  startTime DateTime
  endTime   DateTime
  notes     String?
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

enum Role {
  USER
  ADMIN
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

model SiteSettings {
  id           String @id @default("default")
  siteTitle    String @default("Kragerøhallen Booking")
  logoUrl      String @default("/kif-logo.png")
  primaryColor String @default("#FFD400")
  bgColor      String @default("#1a1a1a")
  navBgColor   String @default("#111111")
  footerText   String @default("Kragerø IF Håndball · Frydensborgveien 13, 3770 Kragerø")
}

model Team {
  id              String   @id @default(cuid())
  name            String
  rosterImportUrl String?
  createdAt       DateTime @default(now())
  players         Player[]
  matches         Match[]
}

model Player {
  id           String       @id @default(cuid())
  teamId       String
  name         String
  number       Int?
  position     String?
  isGoalkeeper Boolean      @default(false)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  events       MatchEvent[] @relation("PlayerEvents")
  assistEvents MatchEvent[] @relation("AssistEvents")
  squadMatches Match[]      @relation("MatchSquad")

  @@index([teamId])
}

model Match {
  id                 String       @id @default(cuid())
  teamId             String
  opponentName       String
  season             String
  date               DateTime
  status             MatchStatus  @default(SCHEDULED)
  period             Int          @default(1)
  clockRunning       Boolean      @default(false)
  clockStartedAt     DateTime?
  accumulatedSeconds Int          @default(0)
  createdById        String
  createdAt          DateTime     @default(now())
  finishedAt         DateTime?
  team               Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  events             MatchEvent[]
  squad              Player[]     @relation("MatchSquad")

  @@index([teamId])
  @@index([teamId, season])
}

model MatchEvent {
  id             String              @id @default(cuid())
  matchId        String
  type           MatchEventType
  period         Int
  minute         Int?
  playerId       String?
  assistPlayerId String?
  zone           GoalZone?
  shotPosition   ShotPosition?
  faultType      TechnicalFaultType?
  punishment     Punishment?
  createdAt      DateTime            @default(now())
  match          Match               @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player         Player?             @relation("PlayerEvents", fields: [playerId], references: [id])
  assistPlayer   Player?             @relation("AssistEvents", fields: [assistPlayerId], references: [id])

  @@index([matchId])
}

enum MatchStatus {
  SCHEDULED
  LIVE
  HALFTIME
  FINISHED
}

enum MatchEventType {
  GOAL
  SHOT_SAVED
  SHOT_MISSED
  TECHNICAL_FAULT
  DEFENSIVE_FOUL
  GOAL_CONCEDED
  SAVE
}

enum TechnicalFaultType {
  STEPS
  CHARGING
  DOUBLE_DRIBBLE
  PASSIVE
  OTHER
}

enum Punishment {
  NONE
  YELLOW
  TWO_MIN
  RED
}

enum GoalZone {
  TL
  TC
  TR
  ML
  MC
  MR
  BL
  BC
  BR
}

enum ShotPosition {
  LEFT_WING
  LEFT_BACK
  CENTER_BACK
  RIGHT_BACK
  RIGHT_WING
  PIVOT
  SEVEN_METER
  FAST_BREAK
}
