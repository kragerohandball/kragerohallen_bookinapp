generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String
  group     String
  password          String?
  mustChangePassword Boolean  @default(false)
  role              Role     @default(USER)
  status            Status   @default(PENDING)
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Room {
  id          String    @id @default(cuid())
  name        String
  capacity    Int
  description String?
  bookings    Booking[]
}

model Booking {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  startTime DateTime
  endTime   DateTime
  notes     String?
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

enum Role {
  USER
  ADMIN
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

model SiteSettings {
  id           String @id @default("default")
  siteTitle    String @default("Kragerøhallen Booking")
  logoUrl      String @default("/kif-logo.png")
  primaryColor String @default("#FFD400")
  bgColor      String @default("#1a1a1a")
  navBgColor   String @default("#111111")
  footerText   String @default("Kragerø IF Håndball · Frydensborgveien 13, 3770 Kragerø")
}
